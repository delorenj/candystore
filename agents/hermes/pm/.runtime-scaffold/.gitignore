# Per-agent runtime — what NOT to commit to the checkpoint repo.
# Sensitive credentials never go in git.
.env
auth.json
auth.lock
gateway.pid
gateway_state.json
processes.json
interrupt_debug.log
.clean_shutdown

# Caches (large, regenerable)
audio_cache/
image_cache/
models_dev_cache.json
context_length_cache.yaml
honcho.json

# Sandboxes (ephemeral execution environments)
sandboxes/

# Runtime logs and generated skill-curator backups are local noise.
logs/**
!logs/
!logs/.gitkeep
skills/.curator_backups/

# SQLite sidecars are recreated at runtime.
*.db-shm
*.db-wal

# Python cruft
__pycache__/
*.pyc
