# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
dist/
build/

# Node / Vite
web/node_modules/
web/dist/
web/.vite/

# Local runtime
.env
.env.local
*.db
*.log
agents/hermes/*/runtime/

# Worktrees and editor files
.worktrees/
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Secrets — .env is materialized by `op inject -i .env.op > .env` on mise enter.
# NEVER commit it. .env.op holds only 1Password references or safe literals and IS committed.
.env
.env.*
!.env.op

# PJAN-82: generated skill projections are never tracked
# sync-skills.py, provision-packs.py and bmad-method rewrite these on every
# run. No trailing slash: some CLIs get a real directory here, some a symlink.
.claude/skills
.codex/skills
.gemini/skills
.copilot/skills
.opencode/skills
.kimi-code/skills
.crush/skills
.cursor/skills
.agents/skills
