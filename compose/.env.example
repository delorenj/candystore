# Candystore sandbox — environment overrides
#
# All values are optional. Defaults work for the local dev sandbox.

# Postgres credentials + database name
CANDYSTORE_DB_USER=candystore
CANDYSTORE_DB_PASSWORD=candystore
CANDYSTORE_DB_NAME=candystore

# Host port mappings
CANDYSTORE_POSTGRES_PORT=5433
CANDYSTORE_APP_PORT=8683
CANDYSTORE_METRICS_PORT=9091
CANDYSTORE_DAPR_HTTP_PORT=3504

# Logging
CANDYSTORE_LOG_LEVEL=INFO
CANDYSTORE_LOG_FORMAT=json

# Dapr pub/sub component name (must match what bloodbank declares).
CANDYSTORE_PUBSUB=bloodbank-pubsub

# Path to bloodbank's Dapr components dir, relative to candystore/compose/.
# Default assumes a sibling checkout at ../../bloodbank.
BLOODBANK_COMPONENTS_PATH=../../bloodbank/compose/components
