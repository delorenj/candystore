# Loopback by default — the ingest+query API is unauthenticated. In the
# container this is overridden to 0.0.0.0 so the Dapr sidecar can reach it;
# the host port is published on 127.0.0.1 (see compose.yml).
APP_HOST=127.0.0.1
APP_PORT=3001
DATABASE_URL=postgresql://candystore:candystore@localhost:5432/candystore
SUBSCRIBE_PUBSUB=bloodbank-pubsub
# ONE wildcard, matching the running container and the BLOODBANK_EVENTS stream
# (subjects: ["bloodbank.evt.>"]). The retired `bloodbank.evt.v1.>` matches
# nothing published today, so a fresh `cp .env.example .env` would project ZERO
# rows with no error in any log -- see candystore/ingest.py.
SUBSCRIBE_TOPIC=bloodbank.evt.>
SUBSCRIBE_ROUTE=/events/all
SUBSCRIBE_MODE=wildcard
