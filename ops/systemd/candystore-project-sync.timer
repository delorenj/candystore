# Canonical copy: candystore/ops/systemd/ (symlinked into ~/.config/systemd/user/).
# RETIRED 2026-10-26: scheduling moved to candybar (33GOD/candybar deploy/migration/ledger.yaml,
# id systemd:candystore-project-sync.timer). Kept for rollback only — never enable this timer.
[Unit]
Description=Run CandyStore project:sync hourly

[Timer]
# New directories are placed at ingest; this picks up newly registered pjangler
# projects, re-resolves directories they claim, and refreshes alias rows. A
# full run takes ~4s.
OnBootSec=3min
OnActiveSec=3min
OnUnitActiveSec=1h
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
